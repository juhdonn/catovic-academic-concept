---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { profile } from '../data/profile';
---

<Layout title="Curriculum vitae">
  <PageHead
    title="Curriculum vitae"
    intro="Education, appointments, professional experience, and research in one document."
  />
  <section class="wrap cv-section section-bottom">
    <div class="cv-details">
      <p class="eyebrow">Original document · PDF</p>
      <h2>August 2025</h2>
      <p>
        The CV linked from his homepage is labeled August 2025. Open the
        original Google Drive document to read or download it.
      </p>
      <a class="button" href={profile.cv}>
        Open CV <span aria-hidden="true">↗</span>
      </a>
      <details>
        <summary>About the two original CV links</summary>
        <p>
          The research page points to a different CV file. Both source links are
          preserved for transparency; their revision order has not been
          established.
        </p>
        <a class="text-link" href={profile.alternateCv}>
          Research-page CV ↗
        </a>
      </details>
    </div>
  </section>
</Layout>
