---
import Layout from '../layouts/Layout.astro';
import PaperRow from '../components/PaperRow.astro';
import { profile, papers } from '../data/profile';
---

<Layout title="Overview">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="little-rule"></span> Economics · Psychology · Philosophy
      </p>
      <h1>
        Understanding
        <br />
        human <em>choice.</em>
      </h1>
      <p class="hero-description">
        A multidisciplinary approach to the way we decide, the risks we take,
        and the beliefs that guide us.
      </p>
      <div class="hero-actions">
        <a class="button" href="/research/">
          Explore research <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          About Ibraheem <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="appointment">
        <span class="appointment-mark" aria-hidden="true">
          ic.
        </span>
        <div>
          <strong>{profile.title}</strong>
          <span>
            {profile.department} · {profile.institution}
          </span>
        </div>
      </div>
    </div>
    <figure class="choice-art">
      <svg
        viewBox="0 0 480 490"
        role="img"
        aria-labelledby="art-title art-desc"
      >
        <title id="art-title">Paths of possibility</title>
        <desc id="art-desc">
          An abstract branching diagram of possible choices. An editorial
          illustration, not research data.
        </desc>
        <defs>
          <pattern
            id="grid"
            width="24"
            height="24"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M24 0H0V24"
              fill="none"
              stroke="#314e40"
              stroke-opacity=".12"
              stroke-width=".6"
            />
          </pattern>
        </defs>
        <rect width="480" height="490" fill="#e7e9df" />
        <rect x="24" y="24" width="432" height="442" fill="url(#grid)" />
        <g fill="none" stroke="#768976" stroke-width="1">
          <circle cx="240" cy="245" r="157" />
          <circle cx="240" cy="245" r="113" />
          <circle cx="240" cy="245" r="69" />
          <path d="M24 245H456M240 24V466" stroke-dasharray="3 7" />
          <path d="M83 245Q175 245 240 88M83 245Q200 245 351 134M83 245Q220 245 397 245M83 245Q200 245 351 356M83 245Q175 245 240 402" />
        </g>
        <path
          d="M83 245Q200 245 351 134"
          fill="none"
          stroke="#254a38"
          stroke-width="2.5"
        />
        <g fill="#e7e9df" stroke="#49604d">
          <circle cx="240" cy="88" r="5" />
          <circle cx="397" cy="245" r="5" />
          <circle cx="351" cy="356" r="5" />
          <circle cx="240" cy="402" r="5" />
        </g>
        <circle cx="83" cy="245" r="8" fill="#254a38" />
        <circle cx="351" cy="134" r="9" fill="#254a38" />
        <circle
          cx="351"
          cy="134"
          r="17"
          fill="none"
          stroke="#254a38"
          stroke-opacity=".3"
        />
        <g
          fill="#445c49"
          font-family="Georgia,serif"
          font-size="14"
          font-style="italic"
        >
          <text x="62" y="223">
            choice
          </text>
          <text x="365" y="119">
            possibility
          </text>
        </g>
        <text
          x="36"
          y="452"
          fill="#526454"
          font-size="9"
          font-family="sans-serif"
          letter-spacing="2"
        >
          THE MANY PATHS OF A DECISION
        </text>
        <text
          x="433"
          y="452"
          fill="#526454"
          font-size="10"
          font-family="sans-serif"
        >
          01
        </text>
      </svg>
      <figcaption>
        <span>CHOICE & CONSEQUENCE</span>
        <span>An exploration across disciplines</span>
      </figcaption>
    </figure>
  </section>
  <section class="interests-band">
    <div class="wrap interests-inner">
      <span class="eyebrow">Areas of inquiry</span>
      <p>
        Behavioral economics <span>·</span> Experimental economics{' '}
        <span>·</span> Neuroeconomics
      </p>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">The research</p>
        <h2>
          Choice, risk,
          <br />
          and the human experience.
        </h2>
      </div>
      <div class="section-aside">
        <p>
          Exploring human behavior through economics, with interests extending
          to psychology, philosophy, and religion.
        </p>
        <a class="text-link" href="/research/">
          View all research <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="featured-list">
      {[papers[0], papers[4], papers[2]].map((paper, i) => (
        <PaperRow paper={paper} number={i + 1} />
      ))}
    </div>
  </section>
  <section class="teaching-feature">
    <div class="wrap teaching-grid">
      <div>
        <p class="eyebrow">In the classroom</p>
        <h2>
          Bringing economic
          <br />
          thinking to life.
        </h2>
      </div>
      <div>
        <p>
          Teaching experience spans macroeconomics, behavioral economics,
          neuroeconomics, and microeconomics at NYU, the University of
          Pennsylvania, Rutgers, and the University of Maryland.
        </p>
        <a class="text-link" href="/teaching/">
          Explore teaching & syllabi <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="contact-strip wrap">
    <p class="eyebrow">Start a conversation</p>
    <h2>
      Ideas begin with
      <br />
      <em>an exchange.</em>
    </h2>
    <a class="text-link" href="/contact/">
      Contact information <span aria-hidden="true">↗</span>
    </a>
  </section>
</Layout>
