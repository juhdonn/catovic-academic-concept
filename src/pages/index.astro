---
import Layout from '../layouts/Layout.astro';
import PaperRow from '../components/PaperRow.astro';
import { profile, papers } from '../data/profile';
---

<Layout title="Overview">
  <section class="academic-intro wrap">
    <div>
      <h1>Ibraheem Catovic</h1>
      <p class="academic-position">
        {profile.title}
        <br />
        {profile.department}, {profile.institution}
      </p>
      <p class="academic-summary">
        Research in behavioral and experimental economics, with interests in
        neuroeconomics, psychology, philosophy, and religion.
      </p>
      <div class="intro-links">
        <a href="/research/">Research</a>
        <a href="/cv/">Curriculum vitae</a>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>
    <aside class="intro-interests" aria-label="Primary research interests">
      <h2>Research interests</h2>
      <ul>
        <li>Behavioral economics</li>
        <li>Experimental economics</li>
        <li>Neuroeconomics</li>
      </ul>
    </aside>
  </section>
  <section class="section wrap selected-research">
    <div class="section-head">
      <h2>Selected research</h2>
      <a class="text-link" href="/research/">
        All research <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="featured-list">
      {[papers[0], papers[4], papers[2]].map((paper, i) => (
        <PaperRow paper={paper} number={i + 1} />
      ))}
    </div>
  </section>
  <section class="wrap teaching-summary">
    <h2>Teaching</h2>
    <div>
      <p>
        Undergraduate courses in macroeconomics, behavioral economics,
        neuroeconomics, and microeconomics. Teaching experience at NYU, the
        University of Pennsylvania, Rutgers, and the University of Maryland.
      </p>
      <a class="text-link" href="/teaching/">
        Courses & syllabi <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>
